# Настройки конкретного сервера. Скопируйте в deploy/site.env (он не попадает в git) и поправьте.
# Адрес приложения снаружи — ссылки в Telegram, синхронизация, проверка после установки
FILAMENT_URL=https://example.com/filament/
# Файл сайта nginx, в HTTPS-блок которого подключается snippets/filament.conf
NGINX_SITE=/etc/nginx/sites-available/example.com
# Владелец кода (по умолчанию — владелец каталога проекта)
#OWNER=deploy
