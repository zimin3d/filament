[Unit]
Description=Filament inventory (gunicorn)
After=network.target

[Service]
# Отдельный пользователь без shell: код читает (владелец — @OWNER@), пишет только в /var/lib/filament
User=filament
Group=filament
WorkingDirectory=@APP_DIR@
Environment=FILAMENT_DATA=/var/lib/filament/data
Environment=HOME=/var/lib/filament
# Код принадлежит @OWNER@ — __pycache__ сервис создать не может и не должен
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@APP_DIR@/venv/bin/gunicorn --workers 2 --threads 4 --timeout 60 --bind 127.0.0.1:8080 app:app
# sudo systemctl reload filament — gunicorn перезапускает воркеры с новым кодом
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
UMask=0027
# Песочница: из /home виден только код и интерпретатор
ProtectHome=tmpfs
BindReadOnlyPaths=@APP_DIR@ @UV_PYTHON@
ProtectSystem=strict
ReadWritePaths=/var/lib/filament
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
